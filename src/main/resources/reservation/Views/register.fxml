<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.effect.DropShadow?>

<VBox spacing="5" alignment="TOP_CENTER"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="reservation.reservation.controller.AuthController"
      style="-fx-background-color: linear-gradient(to bottom right, #003161, #000B58); -fx-padding: 30 0 40 0;">

  <!-- En-tête avec titre -->
  <VBox spacing="5" alignment="CENTER" style="-fx-padding: 0 0 15 0;">
    <Rectangle width="60" height="4" arcWidth="5" arcHeight="5"
               fill="#006A67" style="-fx-effect: dropshadow(gaussian, #006A67, 10, 0.3, 0, 0);"/>
    <Label text="Créer un compte" style="-fx-text-fill: #FDEB9E; -fx-font-size: 28px; -fx-font-weight: bold;">
      <font>
        <Font name="System Bold" size="28"/>
      </font>
    </Label>
    <Label text="Rejoignez notre communauté"
           style="-fx-text-fill: rgba(253, 235, 158, 0.8); -fx-font-size: 14px;"/>
  </VBox>

  <!-- Carte d'inscription -->
  <VBox spacing="5" alignment="CENTER" style="
       -fx-background-color: rgba(255, 255, 255, 0.95);
       -fx-background-radius: 15;
       -fx-padding: 35 30 35 30;
       -fx-effect: dropshadow(gaussian, rgba(0, 11, 88, 0.3), 25, 0.2, 0, 5);
       -fx-border-radius: 15;
       -fx-border-color: #FDEB9E;
       -fx-border-width: 1;
       -fx-max-width: 420;">

    <!-- Champ Nom complet -->
    <VBox spacing="6">
      <Label text="Nom complet" style="-fx-text-fill: #003161; -fx-font-weight: bold; -fx-font-size: 14px;"/>
      <TextField fx:id="nomField" promptText="Votre nom et prénom" style="
          -fx-background-color: white;
          -fx-background-radius: 8;
          -fx-border-radius: 8;
          -fx-border-color: #ccc;
          -fx-border-width: 1.5;
          -fx-padding: 12 15;
          -fx-font-size: 14px;
          -fx-pref-width: 340;
          -fx-pref-height: 45;">
        <VBox.margin>
          <Insets left="0" right="0"/>
        </VBox.margin>
      </TextField>
    </VBox>

    <!-- Champ Email -->
    <VBox spacing="6">
      <Label text="Email" style="-fx-text-fill: #003161; -fx-font-weight: bold; -fx-font-size: 14px;"/>
      <TextField fx:id="emailField" promptText="exemple@email.com" style="
          -fx-background-color: white;
          -fx-background-radius: 8;
          -fx-border-radius: 8;
          -fx-border-color: #ccc;
          -fx-border-width: 1.5;
          -fx-padding: 12 15;
          -fx-font-size: 14px;
          -fx-pref-width: 340;
          -fx-pref-height: 45;">
        <VBox.margin>
          <Insets left="0" right="0"/>
        </VBox.margin>
      </TextField>
    </VBox>

    <!-- Champ Téléphone -->
    <VBox spacing="6">
      <Label text="Téléphone" style="-fx-text-fill: #003161; -fx-font-weight: bold; -fx-font-size: 14px;"/>
      <TextField fx:id="telField" promptText="Votre numéro de téléphone" style="
          -fx-background-color: white;
          -fx-background-radius: 8;
          -fx-border-radius: 8;
          -fx-border-color: #ccc;
          -fx-border-width: 1.5;
          -fx-padding: 12 15;
          -fx-font-size: 14px;
          -fx-pref-width: 340;
          -fx-pref-height: 45;">
        <VBox.margin>
          <Insets left="0" right="0"/>
        </VBox.margin>
      </TextField>
    </VBox>

    <!-- Champ Mot de passe -->
    <VBox spacing="6">
      <Label text="Mot de passe" style="-fx-text-fill: #003161; -fx-font-weight: bold; -fx-font-size: 14px;"/>
      <PasswordField fx:id="passwordField" promptText="Créez un mot de passe sécurisé" style="
          -fx-background-color: white;
          -fx-background-radius: 8;
          -fx-border-radius: 8;
          -fx-border-color: #ccc;
          -fx-border-width: 1.5;
          -fx-padding: 12 15;
          -fx-font-size: 14px;
          -fx-pref-width: 340;
          -fx-pref-height: 45;">
        <VBox.margin>
          <Insets left="0" right="0"/>
        </VBox.margin>
      </PasswordField>
    </VBox>

    <!-- Bouton de création de compte -->
    <Button text="Créer un compte" onAction="#handleRegister" style="
        -fx-background-color: linear-gradient(to right, #006A67, #003161);
        -fx-text-fill: white;
        -fx-font-weight: bold;
        -fx-font-size: 16px;
        -fx-background-radius: 8;
        -fx-padding: 15 0;
        -fx-pref-width: 340;
        -fx-cursor: hand;
        -fx-effect: dropshadow(gaussian, rgba(0, 106, 103, 0.4), 10, 0.3, 0, 2);">
      <VBox.margin>
        <Insets top="15" bottom="10"/>
      </VBox.margin>
    </Button>

    <!-- Section "Déjà un compte ?" -->
    <VBox spacing="15" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
      <HBox alignment="CENTER" spacing="5">
        <Label text="─────────" style="-fx-text-fill: #ddd;"/>
        <Label text="Déjà un compte ?" style="-fx-text-fill: #666; -fx-font-size: 13px;"/>
        <Label text="─────────" style="-fx-text-fill: #ddd;"/>
      </HBox>

      <Button text="Se connecter" onAction="#goToLogin" style="
          -fx-background-color: transparent;
          -fx-border-color: #006A67;
          -fx-border-width: 1.5;
          -fx-border-radius: 8;
          -fx-text-fill: #006A67;
          -fx-font-weight: bold;
          -fx-font-size: 14px;
          -fx-padding: 10 0;
          -fx-pref-width: 340;
          -fx-cursor: hand;">
        <VBox.margin>
          <Insets bottom="5"/>
        </VBox.margin>
      </Button>
    </VBox>

    <!-- Message d'erreur/succès -->
    <Label fx:id="messageLabel" style="
        -fx-text-fill: #d32f2f;
        -fx-font-size: 13px;
        -fx-padding: 10 0 0 0;
        -fx-wrap-text: true;
        -fx-alignment: center;
        -fx-max-width: 340;
        -fx-text-alignment: center;"/>
  </VBox>

  <!-- Pied de page -->
  <VBox alignment="CENTER" style="-fx-padding: 20 0 0 0;">
    <Label text="© 2025 - Tous droits réservés"
           style="-fx-text-fill: rgba(253, 235, 158, 0.6); -fx-font-size: 11px;"/>
  </VBox>
</VBox>