<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="reservation.reservation.controller.AdminController"
      prefHeight="600.0" prefWidth="900.0"
      style="-fx-background-color: #ffffff; -fx-padding: 20;">

    <!-- Header -->
    <HBox style="-fx-background-color: #000B58; -fx-background-radius: 10 10 0 0; -fx-padding: 15px;"
          alignment="CENTER_LEFT">
        <Label text="Gestion des Responsables"
               style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#showAddRespoModal" text="+ Ajouter Responsable"
                style="-fx-background-color: #006A67; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5;"
        />
    </HBox>

    <!-- Zone principale -->
    <VBox style="-fx-background-color: #f5f5f5; -fx-background-radius: 0 0 10 10; -fx-padding: 20;"
          VBox.vgrow="ALWAYS">

        <!-- Barre de recherche et filtres -->
        <HBox spacing="15" style="-fx-padding: 0 0 20 0;">
            <TextField fx:id="infosRespo" promptText="Rechercher par nom, email ou téléphone..."
                       style="-fx-background-color: white; -fx-border-color: #006A67; -fx-border-radius: 5; -fx-border-width: 2; -fx-padding: 10; -fx-font-size: 14px; -fx-pref-width: 300;"/>

            <Button onAction="#ReturnResposFiltree" text="Rechercher"
                    style="-fx-background-color: #003161; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 5;"
            />

            <Region HBox.hgrow="ALWAYS"/>

            <Button onAction="#listRespos" text="Actualiser"
                    style="-fx-background-color: #003161; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 5;"
            />
            <Button text="Retour" onAction="#redirectToDashboard"
                    style="-fx-background-color: #003161; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 5;"
            />
        </HBox>

        <!-- Tableau des responsables -->
        <TableView fx:id="respoTable"
                   style="-fx-background-color: transparent; -fx-border-color: #006A67; -fx-border-radius: 5; -fx-border-width: 2;"
                   VBox.vgrow="ALWAYS">
            <columns>
                <!-- Colonne ID -->
                <TableColumn text="ID" prefWidth="50">
                    <cellValueFactory>
                        <PropertyValueFactory property="id" />
                    </cellValueFactory>
                </TableColumn>

                <!-- Colonne Nom -->
                <TableColumn  text="Nom Complet" prefWidth="200">
                    <cellValueFactory>
                        <PropertyValueFactory property="nomComplet" />
                    </cellValueFactory>
                </TableColumn>

                <!-- Colonne Email -->
                <TableColumn text="Email" prefWidth="200">
                    <cellValueFactory>
                        <PropertyValueFactory property="email" />
                    </cellValueFactory>
                </TableColumn>

                <!-- Colonne Téléphone -->
                <TableColumn text="Téléphone" prefWidth="120">
                    <cellValueFactory>
                        <PropertyValueFactory property="tel" />
                    </cellValueFactory>
                </TableColumn>

                <!-- Colonne Statut -->
                <TableColumn text="Statut" prefWidth="80">
                    <cellValueFactory>
                        <PropertyValueFactory property="actif" />
                    </cellValueFactory>
                </TableColumn>

                <!-- Colonne Actions -->
                <TableColumn text="Actions" prefWidth="150">

                </TableColumn>
            </columns>

            <!-- Message si vide -->
            <placeholder>
                <Label text="Aucun responsable trouvé. Cliquez sur 'Ajouter Responsable' pour en créer un."
                       style="-fx-text-fill: #003161; -fx-font-size: 14px; -fx-padding: 20;"/>
            </placeholder>
        </TableView>

        <!-- Statistiques en bas -->
        <HBox spacing="20" style="-fx-padding: 20 0 0 0;">
            <HBox style="-fx-background-color: white; -fx-background-radius: 5; -fx-padding: 10 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                <Label text="Total:" style="-fx-text-fill: #003161; -fx-font-weight: bold;"/>
                <Label fx:id="totalLabel" text="0" style="-fx-text-fill: #006A67; -fx-font-weight: bold; -fx-padding: 0 0 0 5;"/>
            </HBox>

            <HBox style="-fx-background-color: white; -fx-background-radius: 5; -fx-padding: 10 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                <Label text="Actifs:" style="-fx-text-fill: #003161; -fx-font-weight: bold;"/>
                <Label fx:id="activeLabel" text="0" style="-fx-text-fill: #006A67; -fx-font-weight: bold; -fx-padding: 0 0 0 5;"/>
            </HBox>

            <HBox style="-fx-background-color: white; -fx-background-radius: 5; -fx-padding: 10 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                <Label text="Inactifs:" style="-fx-text-fill: #003161; -fx-font-weight: bold;"/>
                <Label fx:id="inactiveLabel" text="0" style="-fx-text-fill: #006A67; -fx-font-weight: bold; -fx-padding: 0 0 0 5;"/>
            </HBox>
        </HBox>
    </VBox>
</VBox>