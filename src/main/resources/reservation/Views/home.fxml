<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.effect.DropShadow?>

<VBox spacing="0" alignment="TOP_CENTER"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="reservation.reservation.controller.HomeController"
      style="-fx-background-color: linear-gradient(to bottom right, #003161, #000B58);">

    <!-- Barre de navigation -->
    <HBox alignment="CENTER_LEFT" style="
       -fx-background-color: rgba(255, 255, 255, 0.95);
       -fx-padding: 15 30;
       -fx-effect: dropshadow(gaussian, rgba(0, 11, 88, 0.2), 10, 0, 0, 3);"
          prefHeight="70">

        <!-- Logo ou titre de l'application -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Circle radius="20" fill="#006A67">
                <effect>
                    <DropShadow radius="5" color="#006A67" spread="0.3"/>
                </effect>
            </Circle>
            <Label text="ReservationApp" style="-fx-text-fill: #003161; -fx-font-size: 20px; -fx-font-weight: bold;"/>
        </HBox>

        <!-- Espace flexible -->
        <Region HBox.hgrow="ALWAYS"/>

        <!-- Bouton profil et déconnexion -->
        <HBox alignment="CENTER" spacing="15">
            <!-- Bouton Profil -->
            <Button onAction="#showProfile" style="
          -fx-background-color: transparent;
          -fx-text-fill: #003161;
          -fx-font-weight: bold;
          -fx-font-size: 14px;
          -fx-padding: 8 15;
          -fx-cursor: hand;
          -fx-border-color: #006A67;
          -fx-border-width: 1.5;
          -fx-border-radius: 6;">
                <graphic>
                    <HBox alignment="CENTER" spacing="8">
                        <Circle radius="10" fill="#006A67"/>
                        <Label text="Mon Profil" style="-fx-text-fill: #003161;"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- Bouton Déconnexion -->
            <Button onAction="#handleLogout" style="
          -fx-background-color: #006A67;
          -fx-text-fill: white;
          -fx-font-weight: bold;
          -fx-font-size: 14px;
          -fx-padding: 8 20;
          -fx-cursor: hand;
          -fx-background-radius: 6;
          -fx-effect: dropshadow(gaussian, rgba(0, 106, 103, 0.4), 8, 0.3, 0, 2);">
                <graphic>
                    <HBox alignment="CENTER" spacing="8">
                        <Label text="Déconnexion" style="-fx-text-fill: white;"/>
                        <Path fill="#FDEB9E" stroke="#FDEB9E" strokeWidth="2">
                            <elements>
                                <MoveTo x="0" y="0"/>
                                <LineTo x="10" y="5"/>
                                <MoveTo x="0" y="10"/>
                                <LineTo x="10" y="5"/>
                            </elements>
                        </Path>
                    </HBox>
                </graphic>
            </Button>
        </HBox>
    </HBox>

    <!-- Contenu principal -->
    <VBox spacing="30" alignment="CENTER" style="-fx-padding: 50 20;">

        <!-- Message de bienvenue -->
        <VBox spacing="15" alignment="CENTER" style="
         -fx-background-color: rgba(255, 255, 255, 0.95);
         -fx-background-radius: 15;
         -fx-padding: 40 50;
         -fx-effect: dropshadow(gaussian, rgba(0, 11, 88, 0.2), 20, 0.2, 0, 5);
         -fx-border-radius: 15;
         -fx-border-color: #FDEB9E;
         -fx-border-width: 2;
         -fx-max-width: 600;">

            <!-- Icône de bienvenue -->
            <StackPane>
                <Circle radius="50" fill="#006A67" style="-fx-effect: dropshadow(gaussian, #006A67, 15, 0.3, 0, 0);"/>
                <Label text="✓" style="-fx-text-fill: #FDEB9E; -fx-font-size: 40px; -fx-font-weight: bold;"/>
            </StackPane>

            <!-- Message personnalisé -->
            <VBox spacing="10" alignment="CENTER">
                <Label fx:id="welcomeLabel" style="
            -fx-text-fill: #003161;
            -fx-font-size: 32px;
            -fx-font-weight: bold;
            -fx-text-alignment: center;
            -fx-wrap-text: true;">
                    <font>
                        <Font name="System Bold" size="32"/>
                    </font>
                </Label>

                <Label text="Heureux de vous revoir !"
                       style="-fx-text-fill: #006A67; -fx-font-size: 18px; -fx-font-weight: bold;"/>

                <Label text="Votre session a été démarrée avec succès."
                       style="-fx-text-fill: #666; -fx-font-size: 16px; -fx-padding: 10 0 0 0;"/>
            </VBox>

            <!-- Statistiques ou informations -->
            <HBox spacing="30" alignment="CENTER" style="-fx-padding: 30 0 0 0;">
                <VBox spacing="8" alignment="CENTER">
                    <Circle radius="25" fill="#003161" style="-fx-effect: dropshadow(gaussian, #003161, 10, 0.3, 0, 0);"/>
                    <Label text="Statut" style="-fx-text-fill: #003161; -fx-font-weight: bold;"/>
                    <Label text="Connecté" style="-fx-text-fill: #006A67; -fx-font-size: 14px;"/>
                </VBox>

                <VBox spacing="8" alignment="CENTER">
                    <Circle radius="25" fill="#000B58" style="-fx-effect: dropshadow(gaussian, #000B58, 10, 0.3, 0, 0);"/>
                    <Label text="Compte" style="-fx-text-fill: #003161; -fx-font-weight: bold;"/>
                    <Label fx:id="userLabel" style="-fx-text-fill: #006A67; -fx-font-size: 14px; -fx-wrap-text: true;"/>
                </VBox>

                <VBox spacing="8" alignment="CENTER">
                    <Circle radius="25" fill="#FDEB9E" style="-fx-effect: dropshadow(gaussian, #FDEB9E, 10, 0.3, 0, 0);"/>
                    <Label text="Date" style="-fx-text-fill: #003161; -fx-font-weight: bold;"/>
                    <Label fx:id="dateLabel" style="-fx-text-fill: #006A67; -fx-font-size: 14px;"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Actions rapides -->
        <VBox spacing="20" alignment="CENTER" style="-fx-max-width: 600;">
            <Label text="Actions rapides"
                   style="-fx-text-fill: #FDEB9E; -fx-font-size: 24px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>

            <HBox spacing="20" alignment="CENTER">
                <Button text="Mes Réservations" onAction="#showReservations" style="
            -fx-background-color: white;
            -fx-text-fill: #003161;
            -fx-font-weight: bold;
            -fx-font-size: 14px;
            -fx-padding: 15 30;
            -fx-cursor: hand;
            -fx-background-radius: 8;
            -fx-border-radius: 8;
            -fx-border-color: #006A67;
            -fx-border-width: 2;
            -fx-effect: dropshadow(gaussian, rgba(0, 11, 88, 0.1), 10, 0.3, 0, 2);
            -fx-pref-width: 180;">
                    <graphic>
                        <Rectangle width="24" height="24" arcWidth="5" arcHeight="5" fill="#006A67"/>
                    </graphic>
                </Button>

                <Button text="Nouvelle Réservation" onAction="#newReservation" style="
            -fx-background-color: linear-gradient(to right, #006A67, #003161);
            -fx-text-fill: white;
            -fx-font-weight: bold;
            -fx-font-size: 14px;
            -fx-padding: 15 30;
            -fx-cursor: hand;
            -fx-background-radius: 8;
            -fx-effect: dropshadow(gaussian, rgba(0, 106, 103, 0.4), 10, 0.3, 0, 2);
            -fx-pref-width: 180;">
                    <graphic>
                        <Rectangle width="24" height="24" arcWidth="5" arcHeight="5" fill="#FDEB9E"/>
                    </graphic>
                </Button>

                <Button text="Paramètres" onAction="#showSettings" style="
            -fx-background-color: white;
            -fx-text-fill: #003161;
            -fx-font-weight: bold;
            -fx-font-size: 14px;
            -fx-padding: 15 30;
            -fx-cursor: hand;
            -fx-background-radius: 8;
            -fx-border-radius: 8;
            -fx-border-color: #006A67;
            -fx-border-width: 2;
            -fx-effect: dropshadow(gaussian, rgba(0, 11, 88, 0.1), 10, 0.3, 0, 2);
            -fx-pref-width: 180;">
                    <graphic>
                        <Rectangle width="24" height="24" arcWidth="5" arcHeight="5" fill="#003161"/>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </VBox>

    <!-- Pied de page -->
    <VBox alignment="CENTER" style="
       -fx-background-color: rgba(0, 11, 88, 0.9);
       -fx-padding: 20;
       -fx-border-color: #006A67;
       -fx-border-width: 1 0 0 0;">
        <Label text="© 2023 ReservationApp - Tous droits réservés"
               style="-fx-text-fill: rgba(253, 235, 158, 0.7); -fx-font-size: 12px;"/>
        <Label text="Contact : support@reservationapp.com | Tél : +33 1 23 45 67 89"
               style="-fx-text-fill: rgba(253, 235, 158, 0.5); -fx-font-size: 11px; -fx-padding: 5 0 0 0;"/>
    </VBox>
</VBox>